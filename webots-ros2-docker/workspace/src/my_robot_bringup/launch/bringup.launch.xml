<launch>
  <!-- Include Webots simulation -->
  <include file="$(find-pkg-share webots_simulation)/launch/simulation.launch.py"/>

  <!-- Include MoveIt2 demo (move_group + rviz2 + ros2_control + spawners) -->
  <include file="$(find-pkg-share my_robot_moveit_config)/launch/demo.launch.py"/>

  <node
    pkg="my_robot_commander_cpp"
    exec="commander"
    output="screen">
    
    <param name="use_sim_time" value="true"/>
    
  </node>

  <node
    pkg="my_robot_pick_and_place"
    exec="pick_and_place_server"
    output="screen">
    
    <param name="use_sim_time" value="true"/>
    
  </node>
</launch>